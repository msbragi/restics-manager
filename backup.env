# Adattare i percorsi alla macchina: assoluti, senza virgolette o variabili shell.
# Commenti solo su righe separate; timeout in secondi.

# Directory che contiene gli stack; ogni sottocartella con .backup viene inclusa.
STACKS_DIR=/workspace/sites

# Base dei percorsi predefiniti: non modifica quelli indicati esplicitamente sotto.
BACKUP_ROOT=/workspace/.backup

# Directory dei repository Restic cifrati, uno per stack.
# REPOSITORIES_DIR=/workspace/.backup/backup-repositories

# Percorso del file con la password Restic; non inserire qui la password.
# RESTIC_PASSWORD_FILE=/workspace/.backup/backup-secrets/restic.password

# Directory dei log diagnostici privati, con password oscurate.
# BACKUP_LOG_DIR=/workspace/.backup/backup-logs

# Directory base delle nuove copie ripristinate; non sovrascrivono gli stack.
RESTORE_DIR=/workspace/.restores

# Immagine Docker di Restic; scaricata automaticamente se manca in locale.
RESTIC_IMAGE=restic/restic:0.19.1

# Tempo massimo per scaricare l'immagine Restic mancante (default 600 s).
RESTIC_PULL_TIMEOUT=600

# Tempo massimo per le operazioni brevi Restic: probe, init ed elenco snapshot (default 60 s).
RESTIC_CHECK_TIMEOUT=60

# Tempo massimo per ogni operazione di backup o restore Restic (default 3600 s).
RESTIC_BACKUP_TIMEOUT=3600

# Tempo massimo dei comandi Docker; superarlo durante lo stop annulla il backup (default 30 s).
DOCKER_TIMEOUT=30

# Attesa aggiuntiva dello stop per consentire il recupero automatico, senza backup.
# Se non arriva conferma di completamento, serve recupero manuale (default 120 s).
STOP_RECOVERY_TIMEOUT=120
